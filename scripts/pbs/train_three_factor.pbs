#!/bin/bash
#PBS -N three_factor_delay
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/three_factor_delay.log

# ─────────────────────────────────────────────────────────────────────────────
# Three-Factor Delay SNN — SHD Training Job
# Versioned output: results stored in v1/, v2/, v3/, ...
# Submit: qsub scripts/train_three_factor_delay.pbs
# ─────────────────────────────────────────────────────────────────────────────

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SHD
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/three_factor_delay
LOGS=/rds/general/user/ak2721/home/logs

mkdir -p "$RESULTS"
mkdir -p "$LOGS"
cd "$REPO"

# ── Modules ───────────────────────────────────────────────────────────────────
module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

# ── Dependencies ──────────────────────────────────────────────────────────────
python3 -m pip install --user --quiet numpy h5py matplotlib

# ── Pull latest code ──────────────────────────────────────────────────────────
git pull origin main

# ── Environment check ─────────────────────────────────────────────────────────
echo "============================================================"
echo "  Job ID    : $PBS_JOBID"
echo "  Node      : $(hostname)"
echo "  Start     : $(date)"
echo "  Repo      : $REPO"
echo "  Results   : $RESULTS"
echo "============================================================"

nvidia-smi
python3 -c "import torch; print('CUDA    :', torch.cuda.is_available())"
python3 -c "import torch; print('GPU     :', torch.cuda.get_device_name(0))"
python3 -c "import torch; print('PyTorch :', torch.__version__)"

# ── Data check ────────────────────────────────────────────────────────────────
echo ""
echo "Checking SHD data files..."
if [ ! -f "$DATA/shd_train.h5" ]; then
    echo "ERROR: shd_train.h5 not found at $DATA"
    exit 1
fi
if [ ! -f "$DATA/shd_test.h5" ]; then
    echo "ERROR: shd_test.h5 not found at $DATA"
    exit 1
fi
echo "Data files OK"
echo ""

# ── Show existing versions ────────────────────────────────────────────────────
echo "Existing result versions in $RESULTS:"
if [ -d "$RESULTS" ]; then
    ls -d "$RESULTS"/v* 2>/dev/null || echo "  None yet — this will be v1"
fi
echo ""

# ── Probe check before full training ─────────────────────────────────────────
echo "Running probe check..."
python3 -c "
import sys, torch, torch.nn as nn
sys.path.insert(0, 'models')
sys.path.insert(0, '.')
from configs import get_config
from three_factor_delay_model import ThreeFactorDelayNet

cfg = get_config('three_factor_delay')
print('  n_hidden           :', cfg.n_hidden)
print('  max_synaptic_delay :', cfg.max_synaptic_delay)
print('  max_axonal_delay   :', cfg.max_axonal_delay)
print('  tau_mem            :', cfg.tau_mem)
print('  tau_syn            :', cfg.tau_syn)
print('  surrogate_sigma    :', cfg.surrogate_sigma)
print('  lr                 :', cfg.lr)
print('  learning_rate_d    :', cfg.learning_rate_d)

torch.manual_seed(42)
x      = (torch.rand(4, 400, 700) < 0.05).float()
labels = torch.randint(0, 20, (4,))
model  = ThreeFactorDelayNet(cfg)

n_params     = sum(p.numel() for p in model.parameters())
delay_params = sum(p.numel() for n, p in model.named_parameters() if 'delay' in n)
print('  n_params           :', f'{n_params:,}')
print('  delay_params       :', f'{delay_params:,}')

with torch.no_grad():
    out = model(x)

loss = nn.CrossEntropyLoss()(out, labels)
rate = (out / cfg.time_steps).mean().item()

print('  output shape       :', out.shape)
print('  loss               :', round(loss.item(), 5))
print('  approx spike rate  :', round(rate, 4))

if rate < 0.001:
    print('  STATUS: DEAD — check threshold/input scale')
elif rate > 0.5:
    print('  STATUS: SATURATED — too many spikes')
elif 0.01 < rate < 0.3:
    print('  STATUS: OK')
else:
    print('  STATUS: borderline — monitor during training')
"

echo ""
echo "Starting training..."
echo "============================================================"

# ── Training ──────────────────────────────────────────────────────────────────
python3 training/train_three_factor_delay.py \
    --epochs        100                      \
    --datasets-path "$DATA"                   \
    --base-dir      "$RESULTS"

EXIT_CODE=$?

# ── Post-training summary ─────────────────────────────────────────────────────
echo ""
echo "============================================================"
echo "  End time  : $(date)"
echo "  Exit code : $EXIT_CODE"

if [ $EXIT_CODE -eq 0 ]; then
    echo "  Status    : SUCCESS"

    # Find the latest version directory
    LATEST_V=$(ls -d "$RESULTS"/v* 2>/dev/null | sort -V | tail -1)

    if [ -n "$LATEST_V" ]; then
        echo "  Results   : $LATEST_V"

        python3 -c "
import json, glob
summaries = glob.glob('$LATEST_V/*_summary.json')
if summaries:
    with open(summaries[0]) as f:
        s = json.load(f)
    print('  Best acc     :', f\"{s['best_acc']*100:.2f}%\")
    print('  Version      :', f\"v{s.get('version', '?')}\")
    print('  n_params     :', f\"{s['n_params']:,}\")
    bd = s.get('param_breakdown', {})
    print('  weight params:', f\"{bd.get('weight_params', '?'):,}\")
    print('  delay params :', f\"{bd.get('delay_params', '?'):,}\")
    ds = s.get('delay_stats', {})
    for layer, stats in ds.items():
        print(f'  {layer:20s}: mean={stats[\"mean\"]:.2f} max={stats[\"max\"]:.2f}')
else:
    print('  No summary file found in $LATEST_V')
"
    fi
else
    echo "  Status    : FAILED (exit code $EXIT_CODE)"
fi

echo "============================================================"
echo ""
echo "Three-Factor Delay training complete: $(date)"
