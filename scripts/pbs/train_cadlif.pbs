#!/bin/bash
#PBS -N cadlif_shd
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=8:mem=16gb:ngpus=1
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/cadlif_shd.log

# ─────────────────────────────────────────────────────────────────────────────
# cAdLIF (d-cAdLIF) — SHD Training Job
# Deckers et al. 2024
# Versioned output: results/cadlif/v1/, v2/, ...
# Submit: qsub scripts/train_cadlif.pbs
# ─────────────────────────────────────────────────────────────────────────────

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SHD
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/cadlif
LOGS=/rds/general/user/ak2721/home/logs

mkdir -p "$RESULTS"
mkdir -p "$LOGS"
cd "$REPO"

# ── Modules ───────────────────────────────────────────────────────────────────
module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

# ── Dependencies ──────────────────────────────────────────────────────────────
python3 -m pip install --user --quiet numpy h5py matplotlib

# ── Pull latest code ──────────────────────────────────────────────────────────
git pull origin main

# ── Environment check ─────────────────────────────────────────────────────────
echo "============================================================"
echo "  Job ID    : $PBS_JOBID"
echo "  Node      : $(hostname)"
echo "  Start     : $(date)"
echo "  Repo      : $REPO"
echo "  Results   : $RESULTS"
echo "============================================================"

nvidia-smi
python3 -c "import torch; print('CUDA    :', torch.cuda.is_available())"
python3 -c "import torch; print('GPU     :', torch.cuda.get_device_name(0))"
python3 -c "import torch; print('PyTorch :', torch.__version__)"

# ── Data check ────────────────────────────────────────────────────────────────
echo ""
echo "Checking SHD data files..."
if [ ! -f "$DATA/shd_train.h5" ]; then
    echo "ERROR: shd_train.h5 not found at $DATA"
    exit 1
fi
if [ ! -f "$DATA/shd_test.h5" ]; then
    echo "ERROR: shd_test.h5 not found at $DATA"
    exit 1
fi
echo "Data files OK"
echo ""

# ── Show existing versions ────────────────────────────────────────────────────
echo "Existing result versions in $RESULTS:"
if [ -d "$RESULTS" ]; then
    ls -d "$RESULTS"/v* 2>/dev/null || echo "  None yet — this will be v1"
fi
echo ""

# ── Probe check ───────────────────────────────────────────────────────────────
echo "Running probe check..."
python3 -c "
import sys, torch, torch.nn as nn
sys.path.insert(0, 'models')
sys.path.insert(0, '.')
from configs import get_config
from cadlif_model import cAdLIFNet

cfg = get_config('cadlif')
print('  n_hidden   :', cfg.n_hidden)
print('  n_inputs   :', cfg.n_inputs)
print('  time_steps :', cfg.time_steps)
print('  max_delay  :', cfg.max_delay)
print('  lr         :', cfg.lr)
print('  lr_delays  :', cfg.lr_delays)
print('  dropout    :', cfg.dropout_p)
print('  batch_size :', cfg.batch_size)

torch.manual_seed(42)
model  = cAdLIFNet(cfg)
n_params  = sum(p.numel() for p in model.parameters())
delay_p   = sum(p.numel() for n,p in model.named_parameters() if 'delay' in n)
neuron_p  = sum(p.numel() for n,p in model.named_parameters()
                if any(x in n for x in ['alpha','beta','.a','.b']))
weight_p  = n_params - delay_p - neuron_p
print('  weights    :', f'{weight_p:,}')
print('  delays     :', f'{delay_p:,}')
print('  neuron     :', f'{neuron_p:,}')
print('  total      :', f'{n_params:,}')

x      = (torch.rand(2, cfg.time_steps, cfg.n_inputs) < 0.05).float()
labels = torch.randint(0, cfg.n_outputs, (2,))
logits = model(x)
loss   = nn.NLLLoss()(logits, labels)

print('  out shape  :', logits.shape)
print('  loss       :', round(loss.item(), 5))
print('  logits max :', round(logits.max().item(), 4), '(should be <= 0)')

assert not torch.isnan(loss), 'FAIL: NaN loss'
assert (logits <= 0).all(),   'FAIL: logits not log-prob'
print('  STATUS     : OK — safe to train')
"

echo ""
echo "Starting training (100 epochs)..."
echo "============================================================"

# ── Training — 100 epochs ─────────────────────────────────────────────────────
python3 training/train_cadlif.py \
    --epochs        500          \
    --datasets-path "$DATA"      \
    --base-dir      "$RESULTS"

EXIT_CODE=$?

# ── Post-training summary ─────────────────────────────────────────────────────
echo ""
echo "============================================================"
echo "  End time  : $(date)"
echo "  Exit code : $EXIT_CODE"

if [ $EXIT_CODE -eq 0 ]; then
    echo "  Status    : SUCCESS"

    LATEST_V=$(ls -d "$RESULTS"/v* 2>/dev/null | sort -V | tail -1)

    if [ -n "$LATEST_V" ]; then
        echo "  Results   : $LATEST_V"
        python3 -c "
import json, glob
summaries = glob.glob('$LATEST_V/*_summary.json')
if summaries:
    with open(summaries[0]) as f:
        s = json.load(f)
    print('  Best acc     :', f\"{s['best_acc']*100:.2f}%\")
    print('  Version      :', f\"v{s.get('version','?')}\")
    print('  n_params     :', f\"{s['n_params']:,}\")
    bd = s.get('param_breakdown', {})
    print('  weight params:', f\"{bd.get('weight_params',0):,}\")
    print('  delay params :', f\"{bd.get('delay_params',0):,}\")
    print('  neuron params:', f\"{bd.get('neuron_params',0):,}\")
    ds = s.get('delay_stats', {})
    for layer, st in ds.items():
        print(f'  {layer:8s}: mean={st[\"mean\"]:.2f}  max={st[\"max\"]:.2f}  p95={st[\"p95\"]:.2f}')
    ns = s.get('neuron_stats', {})
    for layer, params in ns.items():
        for pname, st in params.items():
            print(f'  {layer} {pname}: mean={st[\"mean\"]:.3f}  std={st[\"std\"]:.3f}')
    accs = s.get('test_accs', [])
    if accs:
        print('  Last 5 test accs:', [f\"{a*100:.2f}%\" for a in accs[-5:]])
"
    fi
else
    echo "  Status    : FAILED (exit code $EXIT_CODE)"
fi

echo "============================================================"
echo ""
echo "cAdLIF 100-epoch run complete: $(date)"
