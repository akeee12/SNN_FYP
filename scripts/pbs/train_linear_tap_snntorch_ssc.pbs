#!/bin/bash
#PBS -N linear_tap_ssc
#PBS -q v1_gpu72
#PBS -l walltime=10:30:00
#PBS -l select=1:ncpus=8:mem=4gb:ngpus=1:gpu_type=RTX6000
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/linear_tap_ssc.log

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SSC
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/linear_tap_ssc
LOGS=/rds/general/user/ak2721/home/logs

mkdir -p "$RESULTS"
mkdir -p "$LOGS"
cd "$REPO"

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

python3 -m pip install --user --quiet snntorch numpy h5py matplotlib

git pull origin main

echo "============================================================"
echo "  Job ID    : $PBS_JOBID"
echo "  Node      : $(hostname)"
echo "  Start     : $(date)"
echo "  Dataset   : SSC"
echo "  Repo      : $REPO"
echo "  Results   : $RESULTS"
echo "============================================================"

nvidia-smi
python3 -c "import torch; print('CUDA:', torch.cuda.is_available())"
python3 -c "import torch; print('GPU :', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU_ONLY')"
python3 -c "import torch; print('PyTorch:', torch.__version__)"
python3 -c "import snntorch; print('snnTorch:', snntorch.__version__)"

echo ""
echo "Checking SSC data files..."
if [ ! -f "$DATA/ssc_train.h5" ]; then
    echo "ERROR: ssc_train.h5 not found at $DATA"
    exit 1
fi
if [ ! -f "$DATA/ssc_test.h5" ]; then
    echo "ERROR: ssc_test.h5 not found at $DATA"
    exit 1
fi
echo "Data files OK"

echo ""
echo "Existing result versions in $RESULTS:"
if [ -d "$RESULTS" ]; then
    ls -d "$RESULTS"/v* 2>/dev/null || echo "  None yet — this will be v1"
fi
echo ""

echo "Running probe check (SSC)..."
python3 -c "
import sys, torch
sys.path.insert(0, 'models')
sys.path.insert(0, '.')
from configs import get_config
from linear_tap_aad_snntorch import LinearTapAADNetSNNTorch

cfg            = get_config('linear_tap_snntorch')
cfg.n_inputs   = 700
cfg.n_outputs  = 35
cfg.time_steps = 400

torch.manual_seed(42)
model    = LinearTapAADNetSNNTorch(cfg)
n_params = sum(p.numel() for p in model.parameters())
x        = (torch.rand(2, cfg.time_steps, cfg.n_inputs) < 0.05).float()
with torch.no_grad():
    out = model(x)
buf_info = model.get_buffer_info()
print('  dataset    : SSC')
print('  n_inputs   : 700')
print('  n_outputs  : 35')
print('  n_params   :', f'{n_params:,}')
print('  out shape  :', tuple(out.shape))
print('  taps       :', buf_info[\"taps\"])
print('  storage    :', buf_info[\"storage\"])
print('  STATUS     : OK')
"

if [ $? -ne 0 ]; then
    echo "ERROR: probe check failed"
    exit 1
fi

echo ""
echo "Starting SSC training (500 epochs)..."
echo "============================================================"

python3 training/train_linear_tap_snntorch.py \
    --epochs        100         \
    --datasets-path "$DATA"     \
    --base-dir      "$RESULTS"  \
    --dataset       ssc

EXIT_CODE=$?

echo ""
echo "============================================================"
echo "  End time  : $(date)"
echo "  Exit code : $EXIT_CODE"

if [ $EXIT_CODE -eq 0 ]; then
    echo "  Status    : SUCCESS"
    LATEST_V=$(ls -d "$RESULTS"/v* 2>/dev/null | sort -V | tail -1)
    if [ -n "$LATEST_V" ]; then
        echo "  Results   : $LATEST_V"
        python3 -c "
import json, glob
summaries = glob.glob('$LATEST_V/*_summary.json')
if summaries:
    with open(summaries[0]) as f:
        s = json.load(f)
    print('  Best acc     :', f\"{s['best_acc']*100:.2f}%\")
    print('  dataset      :', s.get('dataset','?'))
    print('  n_params     :', f\"{s['n_params']:,}\")
    print('  tap_strategy :', s.get('tap_strategy','?'))
    print('  taps         :', s.get('buffer_taps','?'))
    accs = s.get('test_accs', [])
    if accs:
        print('  Last 5 accs  :', [f\"{a*100:.2f}%\" for a in accs[-5:]])
"
    fi
else
    echo "  Status    : FAILED (exit code $EXIT_CODE)"
fi

echo "============================================================"
echo ""
echo "LinearTap SSC training complete: $(date)"
