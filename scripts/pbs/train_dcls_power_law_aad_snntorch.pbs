#!/bin/bash
#PBS -N dcls_power_law_ring_buffer
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=8:mem=8gb:ngpus=1:gpu_type=RTX6000
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/dcls_power_law_ring_buffer.log

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SHD
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/dcls_power_law_ring_buffer
LOGS=/rds/general/user/ak2721/home/logs

mkdir -p "$RESULTS"
mkdir -p "$LOGS"
cd "$REPO"

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

python3 -m pip install --user --quiet spikingjelly numpy h5py matplotlib

git pull origin main

echo "============================================================"
echo "  Job ID    : $PBS_JOBID"
echo "  Node      : $(hostname)"
echo "  Start     : $(date)"
echo "  Repo      : $REPO"
echo "  Results   : $RESULTS"
echo "============================================================"

nvidia-smi
python3 -c "import torch; print('CUDA:', torch.cuda.is_available())"
python3 -c "import torch; print('GPU count:', torch.cuda.device_count())"
python3 -c "import torch; print('GPU :', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU_ONLY')"
python3 -c "import torch; print('PyTorch:', torch.__version__)"
python3 -c "import spikingjelly; print('SpikingJelly:', spikingjelly.__version__)"

echo ""
echo "Checking SHD data files..."
if [ ! -f "$DATA/shd_train.h5" ]; then
    echo "ERROR: shd_train.h5 not found at $DATA"
    exit 1
fi
if [ ! -f "$DATA/shd_test.h5" ]; then
    echo "ERROR: shd_test.h5 not found at $DATA"
    exit 1
fi
echo "Data files OK"

echo ""
echo "Existing result versions in $RESULTS:"
if [ -d "$RESULTS" ]; then
    ls -d "$RESULTS"/v* 2>/dev/null || echo "  None yet — this will be v1"
fi
echo ""

echo "Running probe check..."
python3 -c "
import sys, torch
sys.path.insert(0, 'models')
sys.path.insert(0, '.')
from configs import get_config
from dcls_power_law_ring_buffer_model import DCLSPowerLawRingBufferNet

cfg = get_config('dcls_power_law_ring_buffer')
print('  model_name     :', cfg.model_name)
print('  tap_strategy   : power_law  (list storage)')
print('  gamma          :', cfg.gamma)
print('  taps           :', cfg.taps)
print('  n_taps         :', cfg.n_taps)
print('  buffer_size    :', cfg.buffer_size, '(k)')
print('  buffer_max_lag :', cfg.buffer_max_lag)
print('  theta_u        :', cfg.theta_u)
print('  n_hidden       :', cfg.n_hidden_neurons)
print('  max_delay      :', cfg.max_delay)
print('  v_threshold    :', cfg.v_threshold)
print('  lr_w           :', cfg.lr_w)
print('  lr_pos         :', cfg.lr_pos)
print('  batch_size     :', cfg.batch_size)

torch.manual_seed(42)
model    = DCLSPowerLawRingBufferNet(cfg)
n_params = sum(p.numel() for p in model.parameters())
print('  n_params       :', f'{n_params:,}')

x = torch.zeros(2, cfg.n_inputs, cfg.time_steps)
x[x < 0.05] = 1.0
with torch.no_grad():
    model.reset()
    out = model(x)

buf_info = model.get_buffer_info()
print('  output shape   :', tuple(out.shape))
print('  storage        :', buf_info['storage'])
print('  buf k          :', buf_info['k'])
print('  buf L          :', buf_info['L'])
print('  buf taps       :', buf_info['taps'])
print('  STATUS         : OK')
"

echo ""
echo "Starting training (100 epochs, SHD)..."
echo "============================================================"

python3 training/train_dcls_power_law_ring_buffer.py \
    --epochs        100         \
    --datasets-path "$DATA"     \
    --base-dir      "$RESULTS"  \
    --dataset       shd

EXIT_CODE=$?

echo ""
echo "============================================================"
echo "  End time  : $(date)"
echo "  Exit code : $EXIT_CODE"

if [ $EXIT_CODE -eq 0 ]; then
    echo "  Status    : SUCCESS"
    LATEST_V=$(ls -d "$RESULTS"/v* 2>/dev/null | sort -V | tail -1)
    if [ -n "$LATEST_V" ]; then
        echo "  Results   : $LATEST_V"
        python3 -c "
import json, glob
summaries = glob.glob('$LATEST_V/*_summary.json')
if summaries:
    with open(summaries[0]) as f:
        s = json.load(f)
    print('  Best acc     :', f\"{s['best_acc']*100:.2f}%\")
    print('  Version      :', f\"v{s.get('version','?')}\")
    print('  n_params     :', f\"{s['n_params']:,}\")
    print('  gamma        :', s.get('gamma', '?'))
    print('  taps         :', s.get('buffer_taps', '?'))
    print('  buf k        :', s.get('buffer_k', '?'))
    print('  buf L        :', s.get('buffer_L', '?'))
    accs = s.get('test_accs', [])
    if accs:
        print('  Last 5 accs :', [f\"{a*100:.2f}%\" for a in accs[-5:]])
else:
    print('  No summary file found in $LATEST_V')
"
    fi
else
    echo "  Status    : FAILED (exit code $EXIT_CODE)"
fi

echo "============================================================"
echo ""
echo "DCLSPowerLawRingBufferNet training complete: $(date)"

