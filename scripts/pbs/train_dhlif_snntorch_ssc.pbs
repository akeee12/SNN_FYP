#!/bin/bash
#PBS -N dhlif_ssc
#PBS -l walltime=15:00:00
#PBS -l select=1:ncpus=5:mem=8gb:ngpus=1:gpu_type=RTX6000
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/dhlif_ssc.log

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SSC
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/dhlif_ssc
LOGS=/rds/general/user/ak2721/home/logs

mkdir -p "$LOGS" "$RESULTS"
cd "$REPO"

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

python3 -m pip install --user --quiet snntorch numpy h5py

git pull origin main

echo "============================================================"
echo "  Job     : $PBS_JOBID"
echo "  Model   : DH-LIF"
echo "  Dataset : SSC"
echo "  Node    : $(hostname)"
echo "  Start   : $(date)"
echo "============================================================"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
python3 -c "import torch; print('CUDA:', torch.cuda.is_available(), '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"
python3 -c "import torch; print('PyTorch:', torch.__version__)"

echo ""
echo "Checking SSC data files..."
for f in ssc_train.h5 ssc_test.h5; do
    if [ ! -f "$DATA/$f" ]; then
        echo "ERROR: $f not found at $DATA"; exit 1
    fi
    echo "  $f OK"
done

echo ""
echo "Starting training..."
echo "============================================================"

python3 training/train_dhlif.py \
    --dataset       ssc        \
    --datasets-path "$DATA"    \
    --base-dir      "$RESULTS" \
    --epochs       100

EXIT_CODE=$?

echo ""
echo "============================================================"
echo "  End time  : $(date)"
echo "  Exit code : $EXIT_CODE"
if [ $EXIT_CODE -eq 0 ]; then
    echo "  Status    : SUCCESS"
    python3 - <<PYEOF
import json, glob, os
summaries = glob.glob(os.path.join("$RESULTS", "v*", "*_summary.json"))
if summaries:
    summaries.sort()
    with open(summaries[-1]) as f:
        s = json.load(f)
    print("  Best acc  : {:.2f}%".format(s["best_acc"] * 100))
    print("  n_params  : {:,}".format(s["n_params"]))
    mins = s.get("total_train_time_seconds", 0) / 60
    print("  Time      : {:.1f} min".format(mins))
PYEOF
else
    echo "  Status    : FAILED"
fi
echo "============================================================"
