#!/bin/bash
#PBS -N aadv2_snntorch_dvs
#PBS -l walltime=11:00:00
#PBS -l select=1:ncpus=8:mem=8gb:ngpus=1:gpu_type=RTX6000
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/aadv2_snntorch_dvs.log

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/DVS
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/aad_v2_dvs_500e
LOGS=/rds/general/user/ak2721/home/logs

mkdir -p "$RESULTS"
mkdir -p "$LOGS"

cd "$REPO"

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1
python3 -m pip install --user --quiet snntorch numpy h5py matplotlib

git pull origin main

echo "============================================================"
echo "  Job ID    : $PBS_JOBID"
echo "  Node      : $(hostname)"
echo "  Start     : $(date)"
echo "  Dataset   : DVS Gesture"
echo "  Repo      : $REPO"
echo "  Results   : $RESULTS"
echo "============================================================"

python3 -c "import torch; print('CUDA:', torch.cuda.is_available())"
python3 -c "import torch; print('GPU :', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU_ONLY')"
python3 -c "import torch; print('PyTorch:', torch.__version__)"
python3 -c "import snntorch; print('snnTorch:', snntorch.__version__)"

echo ""
echo "Checking DVS data files..."
if [ ! -f "$DATA/dvs_train.h5" ]; then
    echo "ERROR: dvs_train.h5 not found at $DATA"
    exit 1
fi
if [ ! -f "$DATA/dvs_test.h5" ]; then
    echo "ERROR: dvs_test.h5 not found at $DATA"
    exit 1
fi
echo "Data files OK"

echo ""
echo "Running probe check..."
python3 -c "
import sys, torch
sys.path.insert(0, 'models')
sys.path.insert(0, '.')
from configs import get_config
from adaptiveAxonalDelayV2SNNTorch import AdaptiveAxonalDelayNetV2SNNTorch
cfg = get_config('aad_snntorch')
cfg.n_inputs   = 2048
cfg.n_outputs  = 11
cfg.time_steps = 300
torch.manual_seed(42)
model    = AdaptiveAxonalDelayNetV2SNNTorch(cfg)
n_params = sum(p.numel() for p in model.parameters())
print('  n_params       :', f'{n_params:,}')
x = (torch.rand(2, cfg.time_steps, cfg.n_inputs) < 0.05).float()
with torch.no_grad():
    out = model(x)
print('  output shape   :', tuple(out.shape))
stats = model.get_delay_stats()
print('  d1_p95         :', round(stats['delay1']['p95'], 3))
print('  d2_p95         :', round(stats['delay2']['p95'], 3))
print('  STATUS         : OK')
"

PROBE_EXIT=$?
if [ $PROBE_EXIT -ne 0 ]; then
    echo "ERROR: Probe check failed — aborting."
    exit $PROBE_EXIT
fi

echo ""
echo "Starting DVS Gesture training (500 epochs)..."
echo "============================================================"

python3 training/train_aadv2SNNTorch.py \
    --dataset       dvs                  \
    --epochs        500                  \
    --datasets-path "$DATA"              \
    --base-dir      "$RESULTS"

EXIT_CODE=$?

echo ""
echo "============================================================"
echo "  End time  : $(date)"
echo "  Exit code : $EXIT_CODE"
if [ $EXIT_CODE -eq 0 ]; then
    echo "  Status    : SUCCESS"
    python3 -c "
import json, glob
summaries = glob.glob('$RESULTS/**/*_summary.json', recursive=True)
if summaries:
    summaries.sort()
    with open(summaries[-1]) as f:
        s = json.load(f)
    print('  Best acc    :', f\"{s['best_acc']*100:.2f}%\")
    print('  n_params    :', f\"{s.get('n_params', '?'):,}\")
    print('  results dir :', s.get('results_dir', '?'))
    accs = s.get('test_accs', [])
    if accs:
        print('  Last 5 accs :', [f\"{a*100:.2f}%\" for a in accs[-5:]])
else:
    print('  No summary file found')
"
else
    echo "  Status    : FAILED (exit code $EXIT_CODE)"
fi
echo "============================================================"
echo ""
echo "AAD V2 snnTorch DVS Gesture training complete: $(date)"
