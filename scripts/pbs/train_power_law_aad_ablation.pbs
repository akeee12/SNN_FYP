#!/bin/bash
#PBS -N pl_ring_ablation
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=5:mem=8gb:ngpus=1:gpu_type=RTX6000
#PBS -j oe
#PBS -J 1-12
#PBS -o /rds/general/user/ak2721/home/logs/ablation_pl_ring_^array_index^.log

# ─────────────────────────────────────────────────────────────────────────────
# Power Law Ring Buffer Ablation — PBS Array Job
#
# 12 jobs: n=5..8 (4 tap counts) × 3 network sizes (small/medium/large)
# Gamma fixed at 2.0, max_lag fixed at 64 for n=5,6,7 and 128 for n=8.
#
# TAP SETS (gamma=2.0):
#   n=5 → [1,  4, 16, 36,  64]              max_lag=64
#   n=6 → [1,  3, 10, 23, 41,  64]          max_lag=64
#   n=7 → [1,  2,  7, 16, 28, 44,  64]      max_lag=64  <- production anchor
#   n=8 → [1,  3, 10, 24, 42, 65, 94, 128]  max_lag=128 (tap 65 > 64)
#
# NOTE: n=5 and n=6 were originally excluded due to a flawed viability check
#       that used max_lag=2^(n-1) (16 and 32), producing duplicate taps.
#       At max_lag=64 both are fully valid with unique taps.
#
# Submit:
#   qsub scripts/pbs/ring/ablation_power_law_ring_buffer_snntorch.pbs
#
# Rerun single job (e.g. index 4):
#   qsub -J 4-4 scripts/pbs/ring/ablation_power_law_ring_buffer_snntorch.pbs
# ─────────────────────────────────────────────────────────────────────────────

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SHD
ABLATION_ROOT=/rds/general/user/ak2721/home/results/SNN_FYP/ablation_power_law
LOGS=/rds/general/user/ak2721/home/logs

GAMMA=2.0

mkdir -p "$LOGS"
cd "$REPO"

# ─────────────────────────────────────────────────────────────────────────────
# JOB ARRAY — n=5,6,7,8 × 3 sizes = 12 jobs, 1-based
# ─────────────────────────────────────────────────────────────────────────────

RUNS=(
    ""              # padding — PBS array is 1-based
    "5  small"      #  1
    "5  medium"     #  2
    "5  large"      #  3
    "6  small"      #  4
    "6  medium"     #  5
    "6  large"      #  6
    "7  small"      #  7
    "7  medium"     #  8  <- production anchor
    "7  large"      #  9
    "8  small"      # 10
    "8  medium"     # 11
    "8  large"      # 12
)

IDX=$PBS_ARRAY_INDEX
RUN="${RUNS[$IDX]}"
NUM_TAPS=$(echo "$RUN" | awk '{print $1}')
NET_SIZE=$(echo "$RUN" | awk '{print $2}')

# max_lag: n=5,6,7 use 64; n=8 uses 128 (tap 65 > 64)
if [ "$NUM_TAPS" -eq 8 ]; then
    MAX_LAG=128
else
    MAX_LAG=64
fi

# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

python3 -m pip install --user --quiet snntorch numpy h5py

git pull origin main

echo "============================================================"
echo "  Ablation job  : $PBS_JOBID  (array index $IDX / 12)"
echo "  Run config    : n=$NUM_TAPS  size=$NET_SIZE  max_lag=$MAX_LAG  gamma=$GAMMA"
echo "  Design        : max_lag fixed per n, only tap count varies"
echo "  Node          : $(hostname)"
echo "  Start         : $(date)"
echo "  Repo          : $REPO"
echo "  Training file : training/train_power_law_ring_buffer_ablation_snntorch.py"
echo "============================================================"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
python3 -c "import torch; print('CUDA:', torch.cuda.is_available(), '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"
python3 -c "import torch; print('PyTorch:', torch.__version__)"
python3 -c "import snntorch; print('snnTorch:', snntorch.__version__)"

# ─────────────────────────────────────────────────────────────────────────────
# DATA CHECK
# ─────────────────────────────────────────────────────────────────────────────

echo ""
echo "Checking SHD data files..."
if [ ! -f "$DATA/shd_train.h5" ]; then
    echo "ERROR: shd_train.h5 not found at $DATA"
    exit 1
fi
if [ ! -f "$DATA/shd_test.h5" ]; then
    echo "ERROR: shd_test.h5 not found at $DATA"
    exit 1
fi
echo "Data files OK"

# ─────────────────────────────────────────────────────────────────────────────
# VERSIONING
# Job 1 creates the version dir — all others wait and reuse it
# ─────────────────────────────────────────────────────────────────────────────

mkdir -p "$ABLATION_ROOT"

get_ablation_version_dir() {
    local root="$1"
    local best=-1
    local best_dir=""
    if [ -d "$root" ]; then
        for d in "$root"/v*/; do
            if [ -f "${d}ablation_config.json" ]; then
                vnum="${d%/}"
                vnum="${vnum##*/v}"
                if [ "$vnum" -gt "$best" ] 2>/dev/null; then
                    best=$vnum
                    best_dir="${d%/}"
                fi
            fi
        done
    fi
    echo "$best_dir"
}

if [ "$IDX" -eq 1 ]; then
    echo ""
    echo "Job 1: initialising ablation version directory..."
    python3 - <<PYEOF
import os, json, time

root = "$ABLATION_ROOT"
existing = []
if os.path.isdir(root):
    for entry in os.scandir(root):
        if entry.is_dir() and entry.name.startswith("v"):
            try:
                existing.append(int(entry.name[1:]))
            except ValueError:
                pass
version     = max(existing) + 1 if existing else 1
version_dir = os.path.join(root, f"v{version}")
os.makedirs(version_dir, exist_ok=True)

ablation_cfg = {
    "version"        : version,
    "created_at"     : time.strftime("%Y-%m-%d %H:%M:%S"),
    "strategy"       : "power_law_ring_buffer",
    "training_file"  : "train_power_law_ring_buffer_ablation_snntorch.py",
    "k"              : 32,
    "gamma"          : 2.0,
    "epochs"         : 100,
    "network_sizes"  : ["small", "medium", "large"],
    "n_hidden_map"   : {"small": 64, "medium": 128, "large": 256},
    "n_values"       : [5, 6, 7, 8],
    "max_lag_map"    : {"5": 64, "6": 64, "7": 64, "8": 128},
    "tap_rule"       : "t_i = round(max_lag * (i/(n-1))^gamma)",
    "n_jobs"         : 12,
    "design_note"    : (
        "n=5,6,7 all use max_lag=64 — unique taps confirmed at this value. "
        "n=8 uses max_lag=128 because tap 65 exceeds 64. "
        "n=7 max_lag=64 is production anchor. "
        "n=5 and n=6 were originally excluded due to a flawed check using "
        "max_lag=2^(n-1); at max_lag=64 both produce valid unique tap sets."
    ),
}
config_path = os.path.join(version_dir, "ablation_config.json")
with open(config_path, "w") as f:
    json.dump(ablation_cfg, f, indent=2)

print(f"Ablation v{version} initialised -> {version_dir}")
PYEOF
    echo "Version directory ready."
else
    echo ""
    echo "Job $IDX: waiting for version directory from job 1..."
    WAIT=0
    while [ $WAIT -lt 60 ]; do
        VERSION_DIR=$(get_ablation_version_dir "$ABLATION_ROOT")
        if [ -n "$VERSION_DIR" ]; then
            echo "  Found: $VERSION_DIR"
            break
        fi
        sleep 3
        WAIT=$((WAIT + 3))
    done
    if [ -z "$VERSION_DIR" ]; then
        echo "ERROR: version directory not found after 60s"
        exit 1
    fi
fi

VERSION_DIR=$(get_ablation_version_dir "$ABLATION_ROOT")
echo ""
echo "  Ablation dir  : $VERSION_DIR"
echo "  Run           : k32_n${NUM_TAPS}_lag${MAX_LAG}_g${GAMMA}_${NET_SIZE}"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# PROBE CHECK (GPU node — imports model, runs forward pass)
# ─────────────────────────────────────────────────────────────────────────────

echo "Running probe check for n=$NUM_TAPS, max_lag=$MAX_LAG, gamma=$GAMMA, size=$NET_SIZE..."
python3 - <<PYEOF
import sys, torch
sys.path.insert(0, ".")
sys.path.insert(0, "models")
from configs import get_config
from power_law_tap_aad_snntorch import PowerLawTapAADNetSNNTorch

NETWORK_SIZES = {"small": 64, "medium": 128, "large": 256}

def make_power_law_taps(n, max_lag, gamma):
    if n == 2:
        return [1, max_lag]
    taps = [max(1, round(max_lag * ((i / (n-1)) ** gamma))) for i in range(n)]
    taps[0]  = 1
    taps[-1] = max_lag
    if len(set(taps)) != n:
        raise ValueError(f"Duplicate taps: {taps}")
    return taps

cfg                = get_config("power_law_tap_snntorch")
cfg.n_hidden       = NETWORK_SIZES["$NET_SIZE"]
cfg.gamma          = $GAMMA
cfg.buffer_max_lag = $MAX_LAG
cfg.taps           = make_power_law_taps($NUM_TAPS, $MAX_LAG, $GAMMA)
cfg.n_taps         = len(cfg.taps)

torch.manual_seed(42)
model    = PowerLawTapAADNetSNNTorch(cfg)
n_params = sum(p.numel() for p in model.parameters())
x        = (torch.rand(2, cfg.time_steps, cfg.n_inputs) < 0.05).float()
with torch.no_grad():
    out = model(x)
assert out.shape == (cfg.time_steps, 2, cfg.n_outputs), \
    f"Bad shape: {out.shape}"
buf_info = model.get_buffer_info()
assert buf_info["storage"] == "ring", "Not ring buffer"
assert buf_info["taps"]    == cfg.taps, "Taps mismatch"
anchor = "  <- production anchor" if $NUM_TAPS == 7 else ""
print(f"  n_hidden   : {cfg.n_hidden}")
print(f"  gamma      : {cfg.gamma}")
print(f"  n_taps     : {len(cfg.taps)}{anchor}")
print(f"  taps       : {cfg.taps}")
print(f"  max_lag    : {cfg.buffer_max_lag}")
print(f"  ring depth : {cfg.buffer_max_lag + 1}")
print(f"  n_params   : {n_params:,}")
print(f"  out shape  : {tuple(out.shape)}")
print(f"  STATUS     : OK")
PYEOF

if [ $? -ne 0 ]; then
    echo "ERROR: probe check failed"
    exit 1
fi
echo "Probe check passed."

# ─────────────────────────────────────────────────────────────────────────────
# TRAINING
# ─────────────────────────────────────────────────────────────────────────────

echo ""
echo "Starting training: n=$NUM_TAPS, max_lag=$MAX_LAG, gamma=$GAMMA, size=$NET_SIZE, 100 epochs..."
echo "============================================================"

python3 training/train_power_law_ring_buffer_ablation_snntorch.py \
    --epochs         100             \
    --datasets-path  "$DATA"         \
    --base-dir       "$VERSION_DIR"  \
    --num-taps       "$NUM_TAPS"     \
    --network-size   "$NET_SIZE"     \
    --gamma          "$GAMMA"        \
    --buffer-max-lag "$MAX_LAG"

EXIT_CODE=$?

# ─────────────────────────────────────────────────────────────────────────────
# SUMMARY
# ─────────────────────────────────────────────────────────────────────────────

RUN_NAME="k32_n${NUM_TAPS}_lag${MAX_LAG}_g${GAMMA}_${NET_SIZE}"

echo ""
echo "============================================================"
echo "  End time      : $(date)"
echo "  Exit code     : $EXIT_CODE"
echo "  Run           : $RUN_NAME"

if [ $EXIT_CODE -eq 0 ]; then
    echo "  Status        : SUCCESS"
    RUN_DIR="${VERSION_DIR}/${RUN_NAME}"
    python3 - <<PYEOF
import json, glob, os
run_dir   = "$RUN_DIR"
summaries = glob.glob(os.path.join(run_dir, "*_summary.json"))
if summaries:
    with open(summaries[0]) as f:
        s = json.load(f)
    print(f"  Best acc      : {s['best_acc']*100:.2f}%")
    print(f"  n_params      : {s['n_params']:,}")
    print(f"  n_hidden      : {s['n_hidden']}")
    print(f"  gamma         : {s['gamma']}")
    print(f"  n_taps        : {s['n_taps']}")
    print(f"  taps          : {s['taps']}")
    print(f"  max_lag       : {s['buffer_max_lag']}")
    print(f"  final thea1   : {s.get('final_thea1','?')}")
    print(f"  final thea2   : {s.get('final_thea2','?')}")
    accs = s.get("test_accs", [])
    if accs:
        print(f"  Last 5 accs   : {[f'{a*100:.2f}%' for a in accs[-5:]]}")
    total_mins = s.get("total_train_time_seconds", 0) / 60
    print(f"  Total time    : {total_mins:.1f} min")
else:
    print(f"  WARNING: no summary found in {run_dir}")
PYEOF
else
    echo "  Status        : FAILED (exit code $EXIT_CODE)"
fi

echo "============================================================"
echo ""
echo "Job $IDX complete (n=$NUM_TAPS, gamma=$GAMMA, $NET_SIZE): $(date)"

