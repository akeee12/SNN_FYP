#!/bin/bash
#PBS -N logbuf_aad_model
#PBS -q v1_gpu72
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/logbuf_aad_model.log

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SHD
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/log_buffer_aad_model

mkdir -p "$RESULTS"
mkdir -p /rds/general/user/ak2721/home/logs
cd "$REPO" || { echo "ERROR: cannot cd to $REPO"; exit 1; }

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

nvidia-smi
python3 -c "import torch; print('CUDA:', torch.cuda.is_available())"

python3 training/train.py \
    --models log_buffer_aad_model \
    --epochs 500 \
    --datasets-path "$DATA" \
    --results-dir "$RESULTS"

echo "log_buffer_aad_model training complete: $(date)"
