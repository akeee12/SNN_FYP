#!/bin/bash
#PBS -N logbuf_v1_train
#PBS -l walltime=3:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/logbuf_v1_train.log

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SHD
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/log_buffer_v1

mkdir -p "$RESULTS"
mkdir -p /rds/general/user/ak2721/home/logs
cd "$REPO" || { echo "ERROR: cannot cd to $REPO"; exit 1; }

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

echo "Start: $(date)"
nvidia-smi
python3 -c "import torch; print('CUDA:', torch.cuda.is_available()); print('GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'None')"

# sanity check file exists
ls -l /rds/general/user/ak2721/home/SNN_FYP/training/train_log_bufferv1.py

python3 training/train_log_bufferv1.py \
    --epochs 100 \
    --datasets-path "$DATA" \
    --results-dir "$RESULTS"

echo "log_buffer_v1 training complete: $(date)"
