#!/bin/bash
#PBS -N aad_v2_train
#PBS -q v1_gpu72
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -j oe
#PBS -o /rds/general/user/ak2721/home/logs/aad_v2_train.log

REPO=/rds/general/user/ak2721/home/SNN_FYP
DATA=/rds/general/user/ak2721/home/datasets/SHD
RESULTS=/rds/general/user/ak2721/home/results/SNN_FYP/aad_v2

mkdir -p "$RESULTS"
mkdir -p /rds/general/user/ak2721/home/logs
cd "$REPO"

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

python3 -m pip install --user --quiet numpy h5py matplotlib

git pull origin main

nvidia-smi
python3 -c "import torch; print('CUDA:', torch.cuda.is_available())"
python3 -c "import torch; print('GPU :', torch.cuda.get_device_name(0))"
python3 -c "import torch; print('PyTorch:', torch.__version__)"

echo "Checking SHD data files..."
if [ ! -f "$DATA/shd_train.h5" ]; then
    echo "ERROR: shd_train.h5 not found at $DATA"
    exit 1
fi
if [ ! -f "$DATA/shd_test.h5" ]; then
    echo "ERROR: shd_test.h5 not found at $DATA"
    exit 1
fi
echo "Data files OK"

python3 training/train_aadv2.py \
    --epochs 500 \
    --datasets-path "$DATA" \
    --results-dir   "$RESULTS"

echo "AAD V2 training complete: $(date)"

